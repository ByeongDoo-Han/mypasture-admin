{
  "name": "@mypasture/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "node --env-file=.env.local ./node_modules/next/dist/bin/next dev",
    "build": "npm run build:prod",
    "build:prod": "node --env-file=.env.prod ./node_modules/next/dist/bin/next build",
    "start": "node --env-file=.env.prod ./node_modules/next/dist/bin/next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.8",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
