{
  "name": "@mypasture/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "dotenv -e .env.local -- next dev",
    "build": "next build --webpack",
    "build:prod": "dotenv -e .env.prod -- next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.8",
    "lucide-react": "^1.33.0",
    "next": "^16.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
